{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-gcc15-release",
      "displayName": "vcpkg GCC15 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build",
      "environment": {
        "VCPKG_ROOT": "/root/vcpkg",
        "LD_LIBRARY_PATH": "/root/vcpkg/.toolchains/gcc15/lib:$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_MODE": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-linux-gcc15",
        "VCPKG_HOST_TRIPLET": "x64-linux-gcc15",
        "VCPKG_OVERLAY_TRIPLETS": "$env{VCPKG_ROOT}/custom-triplets",
        "CMAKE_C_COMPILER": "$env{VCPKG_ROOT}/.toolchains/gcc15/bin/x86_64-conda-linux-gnu-gcc",
        "CMAKE_CXX_COMPILER": "$env{VCPKG_ROOT}/.toolchains/gcc15/bin/x86_64-conda-linux-gnu-g++",
        "YOLO_CONFIG_PROFILE": "default",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vcpkg-gcc15-reference",
      "displayName": "vcpkg GCC15 Reference",
      "inherits": "vcpkg-gcc15-release",
      "binaryDir": "${sourceDir}/../build-reference",
      "cacheVariables": {
        "YOLO_CONFIG_PROFILE": "reference"
      }
    },
    {
      "name": "vcpkg-gcc15-openvino",
      "displayName": "vcpkg GCC15 Release + OpenVINO",
      "inherits": "vcpkg-gcc15-release",
      "binaryDir": "${sourceDir}/../build-openvino",
      "cacheVariables": {
        "YOLO_ENABLE_OPENVINO": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vcpkg-gcc15-release",
      "configurePreset": "vcpkg-gcc15-release"
    },
    {
      "name": "vcpkg-gcc15-reference",
      "configurePreset": "vcpkg-gcc15-reference"
    },
    {
      "name": "vcpkg-gcc15-openvino",
      "configurePreset": "vcpkg-gcc15-openvino"
    }
  ],
  "testPresets": [
    {
      "name": "vcpkg-gcc15-release",
      "configurePreset": "vcpkg-gcc15-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vcpkg-gcc15-openvino",
      "configurePreset": "vcpkg-gcc15-openvino",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
